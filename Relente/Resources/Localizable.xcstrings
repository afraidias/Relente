    },
    "The installer couldn't be verified." : {
      "comment" : "Error screen: the macOS installer failed its signature check.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido verificar el instalador."
          }
        }
      }
    },
    "The installer download failed." : {
      "comment" : "Download screen error when downloading a macOS installer fails.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga del instalador ha fallado."
          }
        }
      }
    },
    "The installer download was cancelled. Incomplete work was removed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cancelado la descarga del instalador y se ha eliminado el trabajo incompleto."
          }
        }
      }
    },
    "The installer download was incomplete or had an unexpected size. Try again." : {
      "comment" : "Safe explanation for installer size mismatch.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga estaba incompleta o tenía un tamaño inesperado. Vuelve a intentarlo."
          }
        }
      }
    },
    "The installer download was redirected to an untrusted destination. Try again later." : {
      "comment" : "Safe explanation for a blocked installer redirect.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga se redirigió a un destino no confiable. Inténtalo más tarde."
          }
        }
      }
    },
    "The network connection was interrupted. Check your connection and try again." : {
      "comment" : "Safe explanation for an interrupted installer download.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión de red se interrumpió. Comprueba la conexión y vuelve a intentarlo."
          }
        }
      }
    },
    "The system helper couldn't be installed." : {
      "comment" : "VoiceOver, when registering the helper failed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido instalar el ayudante del sistema."
          }
        }
      }
    },
    "The System Helper Couldn't Be Uninstalled" : {
      "comment" : "Title of the alert when uninstalling fails.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido desinstalar el ayudante del sistema"
          }
        }
      }
    },
    "The system helper didn't respond." : {
      "comment" : "Error screen: the helper didn't answer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ayudante del sistema no ha respondido."
          }
        }
      }
    },
    "The System Helper Is Off" : {
      "comment" : "Title of the alert when Erase and Create finds the helper off.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ayudante del sistema está desactivado"
          }
        }
      }
    },
    "The system helper isn't installed." : {
      "comment" : "Permissions, under the hero: before installing.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ayudante del sistema no está instalado."
          }
        }
      }
    },
    "The system helper prepares your chosen drive with administrator authorization." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ayudante prepara la memoria elegida con tu autorización de administrador."
          }
        }
      }
    },
    "The system helper was turned off." : {
      "comment" : "VoiceOver, when the helper is turned off in System Settings and the app goes back to Permissions.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha desactivado el ayudante del sistema."
          }
        }
      }
    },
    "This can't be undone. Other disks won't be touched." : {
      "comment" : "Review screen warning, second line.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede deshacer. No se tocará ningún otro disco."
          }
        }
      }
    },
    "This installer is already on this Mac." : {
      "comment" : "VoiceOver hint for activating an installer option that reuses a local installer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este instalador ya está en este Mac."
          }
        }
      }
    },
    "This Mac" : {
      "comment" : "Done screen: marks the start-up card that matches the Mac in use.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac"
          }
        }
      }
    },
    "To create an installer, allow Relente in Full Disk Access and keep it enabled in Login Items so its helper can run. You can still choose an installer and USB before granting access; Relente checks the selected USB before it erases it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para crear un instalador, permite Relente en Acceso total al disco y mantenlo activado en Ítems de inicio para que funcione el ayudante. Puedes elegir un instalador y un USB antes de conceder el acceso; Relente comprueba el USB seleccionado antes de borrarlo."
          }
        }
      }
    },
    "Too small" : {
      "comment" : "Status chip under a drive smaller than the installer needs.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado pequeña"
          }
        }
      }
    },
    "Try Again" : {
      "comment" : "Eject alert: try to eject the drive again.\nError screen button: go back to Review with the same drive and installer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reintentar"
          }
        }
      }
    },
    "Try again to erase the drive and start over." : {
      "comment" : "Error screen: what to do after cancelling.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo para borrar la memoria y empezar de cero."
          }
        }
      }
    },
    "Try again, or use a different drive." : {
      "comment" : "Error screen: what to do when the drive couldn't be erased.\nError screen: what to do when the finished drive failed the check.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo o usa otra memoria."
          }
        }
      }
    },
    "Try again. If it keeps happening, quit and open Relente again." : {
      "comment" : "Error screen: what to do when the helper didn't respond.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a intentarlo. Si sigue pasando, cierra Relente y vuelve a abrirlo."
          }
        }
      }
    },
    "Try again. If it keeps happening, use a different drive." : {
      "comment" : "Error screen: what to do after an unknown failure.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo. Si sigue pasando, usa otra memoria."
          }
        }
      }
    },
    "Try again. If the problem continues, restart your Mac." : {
      "comment" : "Recovery hint when macOS couldn't unregister the system helper.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a intentarlo. Si el problema continúa, reinicia el Mac."
          }
        }
      }
    },
    "Try downloading this macOS version again." : {
      "comment" : "VoiceOver hint for activating a failed installer item to retry its download.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta descargar de nuevo esta versión de macOS."
          }
        }
      }
    },
    "Try loading the list again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta cargar la lista de nuevo."
          }
        }
      }
    },
    "Trying Again…" : {
      "comment" : "Permissions: progress label shown while retrying system helper installation.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reintentando…"
          }
        }
      }
    },
    "Turn on Relente in System Settings › General › Login Items, then try again." : {
      "comment" : "Message of the alert when Erase and Create finds the helper off.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Relente en Ajustes del Sistema › General › Ítems de inicio y vuelve a intentarlo."
          }
        }
      }
    },
    "Turn on Relente in System Settings › General › Login Items." : {
      "comment" : "Permissions, under the hero: macOS waits for the user to turn the helper on.",
      "localizations" : {
