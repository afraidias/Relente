        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar %@ %@"
          }
        }
      }
    },
    "Use a different drive." : {
      "comment" : "Error screen: what to do when the helper refused the drive.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa otra memoria."
          }
        }
      }
    },
    "Use a USB drive or SD card with at least %@. %@ or more works for any version of macOS." : {
      "comment" : "Empty state when no drive is connected. First value: minimum size for the chosen installer (e.g. 17.8 GB); second: size that works for any installer (32 GB).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una memoria USB o una tarjeta SD de al menos %1$@. Una de %2$@ o más sirve para cualquier versión de macOS."
          }
        }
      }
    },
    "Use Cancel beside the version to stop this download." : {
      "comment" : "VoiceOver hint for the disabled artwork of an installer currently downloading.",
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Cancelar junto a la versión para detener esta descarga."
          }
