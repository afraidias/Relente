        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SE INSTALARÁ"
          }
        }
      }
    },
    "With Touch ID or your administrator password, every time. Relente never erases a drive without asking you first." : {
      "comment" : "Permissions callout when Touch ID is available for authorization.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Touch ID o tu contraseña de administrador, cada vez. Relente nunca borra una memoria sin preguntarte antes."
          }
        }
      }
    },
    "With your administrator password, every time. Relente never erases a drive without asking you first." : {
      "comment" : "Permissions callout when Touch ID is unavailable and password is the authorization fallback.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu contraseña de administrador, cada vez. Relente nunca borra una memoria sin preguntarte antes."
          }
        }
      }
    },
    "You may need to download this installer again." : {
      "comment" : "Message in the confirmation alert before cancelling a macOS installer download.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que tengas que volver a descargar este instalador."
          }
