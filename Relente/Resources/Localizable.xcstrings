{
  "sourceLanguage" : "en",
  "strings" : {
    "Open System Settings…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Ajustes del Sistema…"
          }
        }
      }
    },
    "Prepare the system helper to create your installer." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara el ayudante del sistema para crear tu instalador."
          }
        }
      }
    },
    "Drive access" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso a la memoria"
          }
        }
      }
    },
    "You may need to allow Relente in Full Disk Access to create the installer." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que necesites permitir Relente en Acceso total al disco para crear el instalador."
          }
        }
      }
    },
    "Each erase requires your administrator authorization." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada borrado requiere tu autorización de administrador."
          }
        }
      }
    },
    "Installing helper…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalando ayudante…"
          }
        }
      }
    },
    "Please wait while macOS registers the helper." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera un momento mientras macOS registra el ayudante."
          }
        }
      }
    },
    "Helper not installed" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayudante no instalado"
          }
        }
      }
    },
    "Install the helper to prepare your USB drive." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala el ayudante para preparar tu memoria USB."
          }
        }
      }
    },
    "Waiting for activation" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando activación"
          }
        }
      }
    },
    "In the window that opens, find Relente under App Background Activity and turn it on. Then return here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la ventana que se abre, busca Relente en Actividad de apps en segundo plano y actívalo. Después vuelve aquí."
          }
        }
      }
    },
    "Helper enabled" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayudante activado"
          }
        }
      }
    },
    "You can continue and choose an installer and a drive." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes continuar y elegir un instalador y una memoria."
          }
        }
      }
    },
    "Couldn’t install the helper" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido instalar el ayudante"
          }
        }
      }
    },
    "Try again. If the problem continues, make sure Relente is in your Applications folder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a intentarlo. Si el problema continúa, comprueba que Relente está en la carpeta Aplicaciones."
          }
        }
      }
    },
    "Helper disabled" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ayudante está desactivado"
          }
        }
      }
    },
    "Your selections are preserved. Install the helper to continue." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu selección se conserva. Instala el ayudante para continuar."
          }
        }
      }
    },
    "Your selections are preserved. Turn on Relente under App Background Activity in System Settings to continue." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu selección se conserva. Activa Relente en Actividad de apps en segundo plano en Ajustes del Sistema para continuar."
          }
        }
      }
    },
    "“%@”" : {
      "comment" : "Done screen, under the drive: the name it has now, in quotes, e.g. “Install macOS Tahoe”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»"
          }
        }
      }
    },
    "“%@” Couldn’t Be Ejected" : {
      "comment" : "Alert title when macOS refuses to eject the drive. The value is the drive's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido expulsar «%@»"
          }
        }
      }
    },
    "“%@” Isn't a macOS Installer" : {
      "comment" : "Alert title when the chosen file isn't an installer. The value is the file's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es un instalador de macOS"
          }
        }
      }
    },
    "“%@” was disconnected." : {
      "comment" : "VoiceOver, when the chosen drive is unplugged on Review. The value is the drive's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha desconectado «%@»."
          }
        }
      }
    },
    "“%@” will be left unusable until it's erased again." : {
      "comment" : "Message of the cancel alert. The value is the drive's name, e.g. SanDisk Ultra.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» quedará inutilizable hasta que se vuelva a borrar."
          }
        }
      }
    },
    "%@" : {
      "comment" : "Done screen subtitle, how long it took. The value is a duration, e.g. 12 minutes or 1 hour, 5 minutes.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ · needs %@" : {
      "comment" : "Under a drive that's too small. Values: its capacity and the size the installer needs, e.g. 8 GB and 17.8 GB.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · necesita %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "Error screen subtitle. First value: why it stopped; second: what to do. Both are full sentences.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ Close any windows or apps using it and try again." : {
      "comment" : "Eject alert. The value is macOS's reason, e.g. “The disk is in use by Finder.”",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cierra las ventanas o apps que la estén usando y vuelve a intentarlo."
          }
        }
      }
    },
    "%@ downloaded" : {
      "comment" : "Bytes downloaded when total size is unknown.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ descargados"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Downloaded bytes and total download size.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de %@"
          }
        }
      }
    },
    "%@ of %@ in use" : {
      "comment" : "Under a drive's usage bar. Values: space in use and capacity, e.g. 10.89 GB of 15.52 GB.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@ en uso"
          }
        }
      }
    },
    "%@ will use %@ of %@, %@ free" : {
      "comment" : "VoiceOver label of the usage bar. Values: installer name (e.g. macOS Tahoe), its size (16.8 GB), the drive's capacity (32 GB) and the space left (15.2 GB).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ocupará %2$@ de %3$@; quedarán %4$@ libres"
          }
        }
      }
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, on %@" : {
      "comment" : "VoiceOver, Done screen drive. First value: its new name; second: the drive, e.g. SanDisk Ultra.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, on %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, en %2$@"
          }
        }
      }
    },
    "%@, this Mac: %@" : {
      "comment" : "VoiceOver, Done screen card of the Mac in use. First value: Apple silicon or Intel; second: what to do.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, this Mac: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, este Mac: %2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "VoiceOver, Done screen card. First value: Apple silicon or Intel; second: what to do.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@/s" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/s"
          }
        }
      }
    },
    "A download is already in progress." : {
      "comment" : "Download screen error when another installer download is already active.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una descarga en curso."
          }
        }
      }
    },
    "A downloaded older version is available" : {
      "comment" : "VoiceOver value for a macOS family whose older-version list contains a complete local installer.",
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una versión anterior descargada"
          }
        }
      }
    },
    "A window or an app may be using it. Close them and try again." : {
      "comment" : "Eject alert when macOS gives no reason.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que una ventana o una app la esté usando. Ciérralas y vuelve a intentarlo."
          }
        }
      }
    },
    "About %@" : {
      "comment" : "Creating screen, REMAINING: estimated time left. The value is a duration, e.g. 4 min or 1 hr, 20 min.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %@"
          }
        }
      }
    },
    "Activity" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actividad"
          }
        }
      }
    },
    "Add Installer…" : {
      "comment" : "VoiceOver name of the dashed square with a plus.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir instalador…"
          }
        }
      }
    },
    "Almost done" : {
      "comment" : "Creating screen, REMAINING: a last phase that doesn't report its progress.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi listo"
          }
        }
      }
    },
    "An item is already at Apple’s installer location. Resolve it in Finder before downloading." : {
      "comment" : "Download screen: Apple’s destination is occupied by an incomplete or unreadable item.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay un elemento en la ubicación del instalador de Apple. Resuélvelo en Finder antes de descargar."
          }
        }
      }
    },
    "Apple isn’t offering a full installer for this Mac right now." : {
      "comment" : "Empty state description on the Download screen.",
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no ofrece ningún instalador completo para este Mac ahora mismo."
          }
        }
      }
    },
    "Apple silicon" : {
      "comment" : "Done screen card heading: Macs with Apple silicon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple silicon"
          }
        }
      }
    },
    "Apple’s installer list changed or has indistinguishable builds. Try refreshing the list." : {
      "comment" : "Download screen: a catalog entry cannot be safely requested by version and build.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista de Apple ha cambiado o hay compilaciones indistinguibles. Actualiza la lista."
          }
        }
      }
    },
    "Apple’s installer list couldn’t be loaded." : {
      "comment" : "Download screen error when the list of full installers cannot be loaded.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido cargar la lista de instaladores de Apple."
          }
        }
      }
    },
    "Apple’s server couldn’t provide the installer. Try again later." : {
      "comment" : "Safe explanation for a rejected installer response.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de Apple no pudo proporcionar el instalador. Inténtalo más tarde."
          }
        }
      }
    },
    "AT START-UP" : {
      "comment" : "Done screen card capsule, uppercase: press the key while the Mac turns on.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AL ENCENDER"
          }
        }
      }
    },
    "Available in a later version." : {
      "comment" : "Help tag of the disabled Erase and Create button, before creating installers is built.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible en una versión posterior."
          }
        }
      }
    },
    "Back" : {
      "comment" : "Secondary button in the assistant footer that goes to the previous step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrás"
          }
        }
      }
    },
    "Calculating…" : {
      "comment" : "Creating screen, REMAINING: not enough data yet to estimate the time left.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculando…"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Alert button: keep the system helper.\nEject alert: close it and stay on the Done screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
          }
        }
      }
    },
    "Cancel Download" : {
      "comment" : "Accessible name for controls that cancel the active full installer download.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar descarga"
          }
        }
      }
    },
    "Cancel Download and Quit" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar descarga y salir"
          }
        }
      }
    },
    "Cancel this download?" : {
      "comment" : "Confirmation alert title before stopping an active macOS installer download.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cancelar esta descarga?"
          }
        }
      }
    },
    "Check it's the right drive and choose it again." : {
      "comment" : "Error screen: what to do when the drive changed after confirming it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que es la memoria correcta y vuelve a elegirla."
          }
        }
      }
    },
    "Checking the bootable installer…" : {
      "comment" : "Creating screen subtitle while Relente checks the completed USB installer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobando el instalador de arranque…"
          }
        }
      }
    },
    "Checking USB Access…" : {

    },
    "Choose a full installer available for this Mac." : {
      "comment" : "Subtitle of the Download screen; availability applies to this Mac.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un instalador completo disponible para este Mac."
          }
        }
      }
    },
    "Choose a local installer or try again later." : {
      "comment" : "Empty state description when Apple successfully returns no compatible full installers.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un instalador local o inténtalo de nuevo más tarde."
          }
        }
      }
    },
    "Choose a USB Drive" : {
      "comment" : "Title of the USB drive screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una memoria USB"
          }
        }
      }
    },
    "Choose an Installer" : {
      "comment" : "Title of the Installer screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un instalador"
          }
        }
      }
    },
    "Choose an installer app, a disk image that contains one, or InstallAssistant.pkg." : {
      "comment" : "Alert message when the chosen file isn't an installer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una app de instalación, una imagen de disco que la contenga o InstallAssistant.pkg."
          }
        }
      }
    },
    "Choose an installer on the Installer screen." : {
      "comment" : "VoiceOver hint when an Apple catalog entry matches multiple local installers.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un instalador en la pantalla Instalador."
          }
        }
      }
    },
    "Choose or drop an installer app, disk image or InstallAssistant.pkg." : {
      "comment" : "Help tag and VoiceOver hint of the dashed square with a plus on the Installer screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige o suelta una app de instalación, una imagen de disco o InstallAssistant.pkg."
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar"
          }
        }
      }
    },
    "Compatibility" : {
      "comment" : "Done screen help: cause title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibilidad"
          }
        }
      }
    },
    "Completed" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completado"
          }
        }
      }
    },
    "Connecting to Apple…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectando con Apple…"
          }
        }
      }
    },
    "Connection" : {
      "comment" : "Done screen help: cause title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión"
          }
        }
      }
    },
    "Contents unknown · %@" : {
      "comment" : "Under a drive whose data Relente can't measure (e.g. formatted for Linux). The value is its capacity.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenido desconocido · %@"
          }
        }
      }
    },
    "Continue" : {
      "comment" : "Primary button in the assistant footer that goes to the next step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar"
          }
        }
      }
    },
    "COPIED" : {
      "comment" : "Creating screen figure: bytes of the installer copied to the drive so far.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "COPIADO"
          }
        }
      }
    },
    "Copy" : {
      "comment" : "Creation phase: copying the installer to the drive.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar"
          }
        }
      }
    },
    "Copying installer files to the USB drive…" : {
      "comment" : "Creating screen subtitle while createinstallmedia copies installer files.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiando los archivos del instalador al USB…"
          }
        }
      }
    },
    "Couldn't Create the Installer" : {
      "comment" : "Title of the Error screen.",
      "localizations" : {
        "es" : {
