{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · needs %@" : {
      "comment" : "Under a drive that's too small. Values: its capacity and the size the installer needs, e.g. 8 GB and 17.8 GB.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · necesita %2$@"
          }
        }
      }
    },
    "%@ of %@ in use" : {
      "comment" : "Under a drive's usage bar. Values: space in use and capacity, e.g. 10.89 GB of 15.52 GB.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@ en uso"
          }
        }
      }
    },
    "Contents unknown · %@" : {
      "comment" : "Under a drive whose data Relente can't measure (e.g. formatted for Linux). The value is its capacity.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenido desconocido · %@"
          }
        }
      }
    },
    "Empty · %@" : {
      "comment" : "Under an empty drive's usage bar. The value is its capacity.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía · %@"
          }
        }
      }
    },
    "“%@”" : {
      "comment" : "Done screen, under the drive: the name it has now, in quotes, e.g. “Install macOS Tahoe”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»"
          }
        }
      }
    },
    "“%@” Couldn’t Be Ejected" : {
      "comment" : "Alert title when macOS refuses to eject the drive. The value is the drive's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido expulsar «%@»"
          }
        }
      }
    },
    "“%@” Isn't a macOS Installer" : {
      "comment" : "Alert title when the chosen file isn't an installer. The value is the file's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es un instalador de macOS"
          }
        }
      }
    },
    "“%@” was disconnected." : {
      "comment" : "VoiceOver, when the chosen drive is unplugged on Review. The value is the drive's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha desconectado «%@»."
          }
        }
      }
    },
    "“%@” will be left unusable until it's erased again." : {
      "comment" : "Message of the cancel alert. The value is the drive's name, e.g. SanDisk Ultra.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» quedará inutilizable hasta que se vuelva a borrar."
          }
        }
      }
    },
    "%@" : {
      "comment" : "Done screen subtitle, how long it took. The value is a duration, e.g. 12 minutes or 1 hour, 5 minutes.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "Error screen subtitle. First value: why it stopped; second: what to do. Both are full sentences.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ Close any windows or apps using it and try again." : {
      "comment" : "Eject alert. The value is macOS's reason, e.g. “The disk is in use by Finder.”",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cierra las ventanas o apps que la estén usando y vuelve a intentarlo."
          }
        }
      }
    },
    "%@ will use %@ of %@, %@ free" : {
      "comment" : "VoiceOver label of the usage bar. Values: installer name (e.g. macOS Tahoe), its size (16.8 GB), the drive's capacity (32 GB) and the space left (15.2 GB).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ocupará %2$@ de %3$@; quedarán %4$@ libres"
          }
        }
      }
    },
    "%@, on %@" : {
      "comment" : "VoiceOver, Done screen drive. First value: its new name; second: the drive, e.g. SanDisk Ultra.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, on %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, en %2$@"
          }
        }
      }
    },
    "%@, this Mac: %@" : {
      "comment" : "VoiceOver, Done screen card of the Mac in use. First value: Apple silicon or Intel; second: what to do.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, this Mac: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, este Mac: %2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "VoiceOver, Done screen card. First value: Apple silicon or Intel; second: what to do.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@/s" : {
      "comment" : "Creating screen, SPEED. The value is an amount of data, e.g. 48 MB; the figure is per second.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/s"
          }
        }
      }
    },
    "A window or an app may be using it. Close them and try again." : {
      "comment" : "Eject alert when macOS gives no reason.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que una ventana o una app la esté usando. Ciérralas y vuelve a intentarlo."
          }
        }
      }
    },
    "About %@" : {
      "comment" : "Creating screen, REMAINING: estimated time left. The value is a duration, e.g. 4 min or 1 hr, 20 min.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %@"
          }
        }
      }
    },
    "Add Installer…" : {
      "comment" : "VoiceOver name of the dashed square with a plus.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir instalador…"
          }
        }
      }
    },
    "Almost done" : {
      "comment" : "Creating screen, REMAINING: a last phase that doesn't report its progress.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi listo"
          }
        }
      }
    },
    "Apple silicon" : {
      "comment" : "Done screen card heading: Macs with Apple silicon.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple silicon"
          }
        }
      }
    },
    "AT START-UP" : {
      "comment" : "Done screen card capsule, uppercase: press the key while the Mac turns on.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AL ENCENDER"
          }
        }
      }
    },
    "Available in a later version." : {
      "comment" : "Help tag of the disabled Erase and Create button, before creating installers is built.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible en una versión posterior."
          }
        }
      }
    },
    "Back" : {
      "comment" : "Secondary button in the assistant footer that goes to the previous step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrás"
          }
        }
      }
    },
    "Calculating…" : {
      "comment" : "Creating screen, REMAINING: not enough data yet to estimate the time left.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculando…"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Eject alert: close it and stay on the Done screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
          }
        }
      }
    },
    "Choose a USB Drive" : {
      "comment" : "Title of the USB drive screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una memoria USB"
          }
        }
      }
    },
    "Choose an Installer" : {
      "comment" : "Title of the Installer screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un instalador"
          }
        }
      }
    },
    "Choose an installer app, a disk image that contains one, or InstallAssistant.pkg." : {
      "comment" : "Alert message when the chosen file isn't an installer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una app de instalación, una imagen de disco que la contenga o InstallAssistant.pkg."
          }
        }
      }
    },
    "Choose or drop an installer app, disk image or InstallAssistant.pkg." : {
      "comment" : "Help tag and VoiceOver hint of the dashed square with a plus on the Installer screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige o suelta una app de instalación, una imagen de disco o InstallAssistant.pkg."
          }
        }
      }
    },
    "Compatibility" : {
      "comment" : "Done screen help: cause title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibilidad"
          }
        }
      }
    },
    "Connection" : {
      "comment" : "Done screen help: cause title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión"
          }
        }
      }
    },
    "Continue" : {
      "comment" : "Primary button in the assistant footer that goes to the next step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar"
          }
        }
      }
    },
    "COPIED" : {
      "comment" : "Creating screen figure: bytes of the installer copied to the drive so far.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "COPIADO"
          }
        }
      }
    },
    "Copy" : {
      "comment" : "Creation phase: copying the installer to the drive.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar"
          }
        }
      }
    },
    "Couldn't Create the Installer" : {
      "comment" : "Title of the Error screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido crear el instalador"
          }
        }
      }
    },
    "Creating installer" : {
      "comment" : "VoiceOver label of the progress ring.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creando el instalador"
          }
        }
      }
    },
    "Creating Installer" : {
      "comment" : "Title of the Creating screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creando el instalador"
          }
        }
      }
    },
    "Creation" : {
      "comment" : "Name of the fourth assistant step, where the installer is being made.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creación"
          }
        }
      }
    },
    "Done" : {
      "comment" : "Name of the assistant's last screen, once the installer is ready.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listo"
          }
        }
      }
    },
    "Download from Apple…" : {
      "comment" : "Button on the Installer screen that opens the installer download screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargar desde Apple…"
          }
        }
      }
    },
    "Download one from Apple, or add one you already have." : {
      "comment" : "Empty state on the Installer screen when no installer is found.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga uno desde Apple o añade uno que ya tengas."
          }
        }
      }
    },
    "Download the installer again, then try again." : {
      "comment" : "Error screen: what to do when the installer is damaged.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a descargar el instalador e inténtalo de nuevo."
          }
        }
      }
    },
    "Drive not showing up at start-up?" : {
      "comment" : "Title of the Done screen's help popover.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No aparece la memoria al arrancar?"
          }
        }
      }
    },
    "Eject" : {
      "comment" : "Done screen button: eject the drive and go back to the first step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expulsar"
          }
        }
      }
    },
    "Eject it and plug it into the Mac where you want to install macOS. It took %@." : {
      "comment" : "Done screen subtitle. The value is how long it took, e.g. 12 minutes.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expúlsala y conéctala al Mac en el que quieras instalar macOS. Ha tardado %@."
          }
        }
      }
    },
    "Erase and Create" : {
      "comment" : "Button that erases the drive and creates the installer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar y crear"
          }
        }
      }
    },
    "Everything on “%@” will be permanently erased." : {
      "comment" : "Review screen warning. The value is the drive's name, e.g. SanDisk Ultra.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrará para siempre todo lo que hay en «%@»."
          }
        }
      }
    },
    "Everything on the drive you choose will be erased." : {
      "comment" : "Subtitle of the USB drive screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrará todo lo que haya en la memoria que elijas."
          }
        }
      }
    },
    "Force Eject" : {
      "comment" : "Eject alert: eject even if something is using the drive.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar expulsión"
          }
        }
      }
    },
    "Format" : {
      "comment" : "Creation phase: erasing and formatting the drive.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatear"
          }
        }
      }
    },
    "Free" : {
      "comment" : "Usage bar legend: free space on the drive.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libre"
          }
        }
      }
    },
    "FREE AFTERWARDS" : {
      "comment" : "Review screen figure: space left on the drive after creating it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LIBRE DESPUÉS"
          }
        }
      }
    },
    "Go" : {
      "comment" : "Menu bar menu with commands to move through the assistant.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir"
          }
        }
      }
    },
    "HOLD" : {
      "comment" : "Done screen card capsule, uppercase: keep the power button pressed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MANTÉN"
          }
        }
      }
    },
    "Hold Option (⌥) right after turning on the Mac, then choose “%@”." : {
      "comment" : "Done screen card for Intel Macs. The value is the drive's name, e.g. Install macOS Tahoe.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la tecla Opción (⌥) nada más encender el Mac y elige «%@»."
          }
        }
      }
    },
    "Hold the power button until you see the start-up options, then choose “%@”." : {
      "comment" : "Done screen card for Apple silicon Macs. The value is the drive's name, e.g. Install macOS Tahoe.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el botón de encendido hasta ver las opciones de arranque y elige «%@»."
          }
        }
      }
    },
    "I understand that all data on this drive will be lost." : {
      "comment" : "Required checkbox before erasing the drive.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo que se perderán todos los datos de esta memoria."
          }
        }
      }
    },
    "Installer" : {
      "comment" : "Name of the first assistant step, where the macOS installer is chosen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalador"
          }
        }
      }
    },
    "Installer Ready" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalador listo"
          }
        }
      }
    },
    "Installer: %@ %@, %@" : {
      "comment" : "VoiceOver label of the installer reminder on the USB Drive screen. Values: name, version and size, e.g. macOS Tahoe, 26.0, 16.8 GB.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalador: %1$@ %2$@, %3$@"
          }
        }
      }
    },
    "Intel" : {
      "comment" : "Done screen card heading: Macs with an Intel processor.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intel"
          }
        }
      }
    },
    "Intel Mac with the T2 chip (2018–2020)" : {
      "comment" : "Done screen help: cause title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Intel con chip T2 (2018–2020)"
          }
        }
      }
    },
    "It only shows up on Macs that support %@." : {
      "comment" : "Done screen help. The value is the macOS version, e.g. macOS Tahoe.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo aparece en los Mac compatibles con %@."
          }
        }
      }
    },
    "Keep Going" : {
      "comment" : "Alert button: don't stop, keep creating the installer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir"
          }
        }
      }
    },
    "Keep the drive plugged in. This can take a while." : {
      "comment" : "Subtitle of the Creating screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la memoria conectada. Puede tardar un rato."
          }
        }
      }
    },
    "less than a minute" : {
      "comment" : "Done screen subtitle, how long it took: under 60 seconds.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "menos de un minuto"
          }
        }
      }
    },
    "Less than a minute" : {
      "comment" : "Creating screen, REMAINING: under 60 seconds left.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de un minuto"
          }
        }
      }
    },
    "Make bootable" : {
      "comment" : "Creation phase: making the drive able to start a Mac.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer booteable"
          }
        }
      }
    },
    "Make sure this is the right drive. Everything on it will be erased." : {
      "comment" : "Subtitle of the Review screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que es la memoria correcta. Se borrará todo lo que contiene."
          }
        }
      }
    },
    "Needs macOS Big Sur or later" : {
      "comment" : "Under an installer older than macOS Big Sur, which Relente can't use.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere macOS Big Sur o posterior"
          }
        }
      }
    },
    "No Installers Found" : {
      "comment" : "Empty state title on the Installer screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han encontrado instaladores"
          }
        }
      }
    },
    "No USB Drive Connected" : {
      "comment" : "Empty state title on the USB Drive screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna memoria USB conectada"
          }
        }
      }
    },
    "Not supported" : {
