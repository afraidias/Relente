          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido en la fase %1$lld de %2$lld, %3$@"
          }
        }
      }
    },
    "The drive didn't pass the final check." : {
      "comment" : "Error screen: the finished drive failed Relente's verification.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria no ha superado la comprobación final."
          }
        }
      }
    },
    "The drive is no longer connected." : {
      "comment" : "Eject alert: the drive is gone.",
