          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectarla e inténtalo de nuevo."
          }
        }
      }
    },
    "Plug it straight into the Mac, not into a hub, and try another port." : {
      "comment" : "Done screen help: what to do about the connection.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctala directamente al Mac, sin hub, y prueba otro puerto."
