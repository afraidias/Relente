        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria ya no está conectada."
          }
        }
      }
    },
    "The drive was disconnected." : {
      "comment" : "Error screen: the drive was unplugged while creating.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria se ha desconectado."
          }
        }
