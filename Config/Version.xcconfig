//
//  Version.xcconfig
//  Relente
//
//  App version, shared by every target. release-please updates
//  MARKETING_VERSION automatically in its release pull requests;
//  don't change it by hand.
//

// User-facing version (semver).
MARKETING_VERSION = 0.4.0 // x-release-please-version

// Build number. release-please doesn't touch it; it stays at 1 until it's
// automated before the first signed build is distributed (see BUILDING.md).
CURRENT_PROJECT_VERSION = 1
